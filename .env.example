# Copy to .env for docker compose. No real secrets belong in this file.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=relicx
POSTGRES_USER=relicx
POSTGRES_PASSWORD=change_me

# --- API ---
RELICX_ENV=production
RELICX_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RELICX_MAX_UPLOAD_MB=15
RELICX_MAX_FRAGMENTS=64
RELICX_LOG_LEVEL=INFO
RELICX_JOB_WORKERS=2
RELICX_SCALING_RATE_PER_MIN=10
# Leave empty for no write protection (lab default). Set to a long random string for a shared instance.
RELICX_API_KEY=

