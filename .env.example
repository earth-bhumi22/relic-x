# Copy to .env for docker compose. No real secrets belong in this file.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=relicx
POSTGRES_USER=relicx
POSTGRES_PASSWORD=change_me

# --- API ---
RELICX_ENV=production
RELICX_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RELICX_MAX_UPLOAD_MB=15
RELICX_MAX_FRAGMENTS=64
RELICX_LOG_LEVEL=INFO

