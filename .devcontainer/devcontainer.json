{
  "name": "RELIC-X",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API (FastAPI /docs)" },
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -e 'backend[api,dev]' && cd frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.black-formatter", "dbaeumer.vscode-eslint", "bierner.markdown-mermaid"]
    }
  }
}
