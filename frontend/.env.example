# Copy to .env.local to override. All variables are optional.

# Serve every API call from src/api/mocks instead of the backend (no backend needed).
# `npm run dev:mock` sets this for you via .env.mock.
VITE_USE_MOCKS=false

# Simulated latency (ms) for mock responses, so loading states are visible. Default 350.
# VITE_MOCK_LATENCY_MS=350

# Origin prepended to /api/v1 in real mode. Leave empty to use relative URLs (recommended:
# the dev server and nginx both proxy /api).
VITE_API_BASE=

# Dev-server only (read by vite.config.ts): where /api is proxied to.
VITE_API_PROXY=http://localhost:8000

# Client-side upload cap in MB, shown in the wizard and checked before upload. Keep it equal to the server's
# RELICX_MAX_UPLOAD_MB (default 15); the server is always the final authority.
# VITE_MAX_UPLOAD_MB=15
